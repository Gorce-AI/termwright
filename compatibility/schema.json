{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce-ai.github.io/termwright/compatibility/schema.json",
  "title": "termwright framework compatibility registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/framework" }
    }
  },
  "$defs": {
    "versionSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "declared", "verified"],
      "properties": {
        "policy": { "enum": ["exact", "range"] },
        "declared": { "type": "string", "minLength": 1 },
        "verified": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "capabilities"],
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "patchSetVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "patchSetVersion": { "type": "integer", "minimum": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frameworkVersion", "modules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "frameworkVersion": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/module" }
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package", "packageVersion", "apis", "notes"],
      "properties": {
        "kind": { "enum": ["framework-native", "termwright-sdk"] },
        "package": { "type": "string", "minLength": 1 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "apis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "frameworkPackage",
        "versions",
        "runtimes",
        "probe",
        "instrumentation",
        "annotations",
        "limitations",
        "documentation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "frameworkPackage": { "type": "string", "minLength": 1 },
        "versions": { "$ref": "#/$defs/versionSupport" },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtime" }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "packageVersion",
            "launch",
            "identityKind",
            "capabilities",
            "adapterCapabilityVariants"
          ],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "packageVersion": { "type": "string", "minLength": 1 },
            "launch": { "type": "string", "minLength": 1 },
            "identityKind": { "enum": ["stable", "frame-local", "correlated"] },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "adapterCapabilityVariants": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/capabilityVariant" }
            }
          }
        },
        "instrumentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "variants"],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/$defs/variant" }
            }
          }
        },
        "annotations": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/annotations" }
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "documentation": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
