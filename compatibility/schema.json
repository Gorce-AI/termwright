{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce-ai.github.io/termwright/compatibility/schema.json",
  "title": "termwright framework compatibility registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/framework" }
    }
  },
  "$defs": {
    "versionSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "declared", "verified"],
      "properties": {
        "policy": { "enum": ["exact", "range"] },
        "declared": { "type": "string", "minLength": 1 },
        "verified": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "capabilities"],
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "geometryCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayed",
        "intendedRect",
        "visibleRect",
        "hitTest",
        "runtimePreconditions",
        "reason"
      ],
      "properties": {
        "displayed": { "$ref": "#/$defs/availability" },
        "intendedRect": { "$ref": "#/$defs/availability" },
        "visibleRect": { "$ref": "#/$defs/availability" },
        "hitTest": { "$ref": "#/$defs/availability" },
        "runtimePreconditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayed": { "$ref": "#/$defs/preconditions" },
            "intendedRect": { "$ref": "#/$defs/preconditions" },
            "visibleRect": { "$ref": "#/$defs/preconditions" },
            "hitTest": { "$ref": "#/$defs/preconditions" },
            "pointerActions": { "$ref": "#/$defs/preconditions" }
          }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "availability": {
      "enum": ["automatic", "application-integrated", "unsupported"]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "patchSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "patchSetVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "patchSetVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "variantModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frameworkVersion", "modules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "frameworkVersion": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variantModule" }
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package", "packageVersion", "apis", "notes"],
      "properties": {
        "kind": { "enum": ["framework-native", "termwright-sdk"] },
        "package": { "type": "string", "minLength": 1 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "apis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "adapterVersion", "strategy", "checksumSources"],
      "properties": {
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*@[^/]+/[^/]+$" }, "uniqueItems": true },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["native-hook", "checksummed-instrumentation", "checksummed-replacement"] },
        "checksumSources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(packages|clients)/.+\\.json$" },
          "uniqueItems": true
        }
      }
    },
    "applicationProviders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedTypes", "extendableCapabilities", "sdks"],
      "properties": {
        "acceptedTypes": { "type": "array", "items": { "enum": ["pointer-evidence", "scroll-evidence", "focus-evidence"] }, "uniqueItems": true },
        "extendableCapabilities": { "type": "array", "items": { "enum": ["pointer-geometry", "pointer-hit-testing", "scroll", "focus"] }, "uniqueItems": true },
        "sdks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "terminalPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "requirements"],
      "properties": {
        "capability": { "enum": ["keyboard-input", "pointer-input", "hover", "drag", "wheel"] },
        "requirements": { "$ref": "#/$defs/preconditions" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "areas", "fixtures"],
      "properties": {
        "suite": { "const": "@termwright/conformance" },
        "areas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "fixtures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "frameworkPackage",
        "versions",
        "runtimes",
        "probe",
        "geometry",
        "instrumentation",
        "annotations",
        "certification",
        "applicationProviders",
        "terminalPrerequisites",
        "conformance",
        "limitations",
        "documentation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "frameworkPackage": { "type": "string", "minLength": 1 },
        "versions": { "$ref": "#/$defs/versionSupport" },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtime" }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "packageVersion",
            "launch",
            "identityKind",
            "capabilities",
            "adapterCapabilityVariants"
          ],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "packageVersion": { "type": "string", "minLength": 1 },
            "launch": { "type": "string", "minLength": 1 },
            "identityKind": { "enum": ["stable", "frame-local", "correlated"] },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "adapterCapabilityVariants": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/capabilityVariant" }
            }
          }
        },
        "geometry": { "$ref": "#/$defs/geometryCapabilities" },
        "instrumentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "patchSets", "variants"],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "patchSets": {
              "type": "array",
              "items": { "$ref": "#/$defs/patchSet" }
            },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/$defs/variant" }
            }
          }
        },
        "annotations": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/annotations" }
          ]
        },
        "certification": { "$ref": "#/$defs/certification" },
        "applicationProviders": { "$ref": "#/$defs/applicationProviders" },
        "terminalPrerequisites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/terminalPrerequisite" }
        },
        "conformance": { "$ref": "#/$defs/conformance" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "documentation": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
