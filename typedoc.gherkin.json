{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/gherkin/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "packages/gherkin/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter"],
  "out": "website/src/content/docs/api/gherkin",
  "readme": "none",
  "entryFileName": "index.md",
  "cleanOutputDir": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "githubPages": false,
  "gitRevision": "main",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/Gorce-AI/termwright/blob/main/packages/gherkin/src/{path}#L{line}",
  "router": "member",
  "frontmatterGlobals": { "editUrl": false }
}
