{
  "name": "@termwright/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm --filter @termwright/protocol build && pnpm --dir .. docs:api",
    "build": "pnpm run check:brand && pnpm run check:geometry && pnpm run check:runner-assets && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:brand": "node scripts/check-brand.mjs",
    "generate:geometry": "node scripts/check-geometry-matrix.mjs --write",
    "check:geometry": "node scripts/check-geometry-matrix.mjs",
    "check:runner-assets": "node scripts/check-runner-assets.mjs",
    "check:links": "node scripts/check-links.mjs dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.6.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
