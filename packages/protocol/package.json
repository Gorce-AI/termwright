{
  "name": "@termwright/protocol",
  "version": "0.2.0",
  "description": "termwright semantic protocol: schemas, limits, roles, framing, handshake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./action-model": {
      "types": "./dist/action-model.d.ts",
      "import": "./dist/action-model.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/contract.ts src/action-model.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:hostile": "vitest run --config vitest.hostile.config.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
