{
  "name": "@termwright/trace",
  "version": "0.5.0",
  "description": "trace format: asciicast v3 + events + semantics, readers/writers, HTML report",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/trace"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/trace"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/vt": "workspace:*",
    "asciinema-player": "^3.17.0",
    "fflate": "^0.8.3"
  }
}
