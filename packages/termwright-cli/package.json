{
  "name": "termwright",
  "version": "0.4.1",
  "description": "umbrella package + CLI: ui, codegen, mcp, agent-context, usage, skill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/termwright-cli"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./ink": {
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.js"
    },
    "./gherkin": {
      "types": "./dist/gherkin.d.ts",
      "import": "./dist/gherkin.js"
    },
    "./gherkin/runtime": {
      "types": "./dist/gherkin-runtime.d.ts",
      "import": "./dist/gherkin-runtime.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "termwright": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/test.ts src/ink.ts src/gherkin.ts src/gherkin-runtime.ts src/host.ts src/doctor.ts src/cli.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/termwright-cli"
  },
  "dependencies": {
    "@termwright/desktop-host": "workspace:*",
    "@termwright/driver": "workspace:*",
    "@termwright/gherkin": "workspace:*",
    "@termwright/ink": "workspace:*",
    "@termwright/mcp": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/resource-broker": "workspace:*",
    "@termwright/run-history": "workspace:*",
    "@termwright/run-journal-transport": "workspace:*",
    "@termwright/test": "workspace:*",
    "@termwright/ui": "workspace:*",
    "@termwright/screenshot": "workspace:*",
    "@termwright/trace": "workspace:*",
    "vitest": "4.1.11"
  }
}
