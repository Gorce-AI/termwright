{
  "name": "termwright",
  "version": "0.2.0",
  "description": "umbrella package + CLI: ui, codegen, mcp, agent-context, usage, skill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/termwright-cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./ink": {
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.js"
    },
    "./gherkin": {
      "types": "./dist/gherkin.d.ts",
      "import": "./dist/gherkin.js"
    },
    "./gherkin/runtime": {
      "types": "./dist/gherkin-runtime.d.ts",
      "import": "./dist/gherkin-runtime.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    },
    "./ui-reporter": {
      "types": "./dist/ui-reporter.d.ts",
      "import": "./dist/ui-reporter.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "termwright": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/test.ts src/ink.ts src/gherkin.ts src/gherkin-runtime.ts src/reporter.ts src/ui-reporter.ts src/doctor.ts src/cli.ts src/bin.ts src/vitest-ui-host.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@termwright/desktop-host": "workspace:*",
    "@termwright/driver": "workspace:*",
    "@termwright/gherkin": "workspace:*",
    "@termwright/ink": "workspace:*",
    "@termwright/mcp": "workspace:*",
    "@termwright/test": "workspace:*",
    "@termwright/ui": "workspace:*",
    "@termwright/screenshot": "workspace:*",
    "@termwright/trace": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
