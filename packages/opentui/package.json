{
  "name": "@termwright/opentui",
  "version": "0.3.1",
  "description": "Optional annotation-only SDK for the zero-config OpenTUI probe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/opentui"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/opentui",
    "test:annotations": "pnpm --dir ../.. test -- -- packages/opentui/src/annotations.test.ts"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.3"
  }
}
