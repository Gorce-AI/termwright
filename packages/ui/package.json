{
  "name": "@termwright/ui",
  "version": "0.5.0",
  "description": "interactive runner: local server + browser app (live view, inspector, time travel, recorder)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live-client": {
      "types": "./dist/live-client.d.ts",
      "import": "./dist/live-client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run check:boundary && tsup src/index.ts src/live-client.ts --format esm --dts --sourcemap --clean && vite build",
    "build:app": "vite build",
    "check:boundary": "node scripts/check-boundary.mjs",
    "screenshots:docs": "node scripts/capture-docs-screenshots.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/ui",
    "test:browser": "pnpm --dir ../.. test -- -- --config packages/ui/vitest.browser.config.ts"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/run-history": "workspace:*",
    "@termwright/trace": "workspace:*",
    "@termwright/vt": "workspace:*",
    "chokidar": "^4.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "^8.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@vitejs/plugin-react": "5.2.0",
    "lucide-react": "1.33.0",
    "playwright": "^1.50.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  }
}
