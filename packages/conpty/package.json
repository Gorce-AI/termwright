{
  "name": "@termwright/conpty",
  "version": "0.2.0",
  "description": "termwright's Windows ConPTY backend: authoritative output EOF and job-object process ownership",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/conpty"
  },
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "build:native": "node-gyp rebuild",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/conpty"
  },
  "optionalDependencies": {
    "@termwright/conpty-win32-x64": "workspace:*",
    "@termwright/conpty-win32-arm64": "workspace:*"
  },
  "devDependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "vitest": "4.1.11"
  }
}
