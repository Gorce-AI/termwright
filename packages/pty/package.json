{
  "name": "@termwright/pty",
  "version": "0.3.1",
  "description": "Termwright's native PTY backend with authoritative output EOF and owned process trees",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/pty"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "build:native": "node-gyp rebuild && node ../../scripts/stage-vendored-conpty.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/pty"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "optionalDependencies": {
    "@termwright/pty-darwin-arm64": "workspace:*",
    "@termwright/pty-darwin-x64": "workspace:*",
    "@termwright/pty-linux-arm64": "workspace:*",
    "@termwright/pty-linux-x64": "workspace:*",
    "@termwright/pty-win32-arm64": "workspace:*",
    "@termwright/pty-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@termwright/resource-broker": "workspace:*",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^12.3.0",
    "vitest": "4.1.11"
  }
}
