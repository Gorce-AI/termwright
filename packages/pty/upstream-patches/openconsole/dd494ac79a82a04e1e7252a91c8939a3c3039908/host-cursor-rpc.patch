+void InteractDispatch::MoveCursorForHostRequest(const VTInt row, const VTInt col, const uintptr_t target, const uint32_t generation, const std::shared_ptr<void>& opaqueSynchronization)
+{
+    if (target == 0)
+    {
+        MoveCursor(row, col);
+        return;
+    }
+
+    const auto synchronization = std::static_pointer_cast<ConptyCursorPositionSynchronization>(opaqueSynchronization);
+    if (!synchronization || synchronization->canceled.load(std::memory_order_relaxed) || synchronization->generation.load(std::memory_order_relaxed) != generation)
+    {
+        return;
+    }
+
+    auto& info = *reinterpret_cast<SCREEN_INFORMATION*>(target);
+    const auto viewport = info.GetViewport();
+    til::point cursor{ col - 1 + viewport.Left(), row - 1 + viewport.Top() };
+    cursor.y = std::clamp(cursor.y, viewport.Top(), viewport.BottomInclusive());
+    cursor.x = std::clamp(cursor.x, viewport.Left(), viewport.RightInclusive());
+    const auto& api = ServiceLocator::LocateGlobals().api;
+    const auto result = api->SetConsoleCursorPositionImpl(info, cursor);
+    if (FAILED(result))
+    {
+        FAIL_FAST_HR(result);
+    }
+    info.ResetConptyCursorPositionGeneration(generation);
+}
