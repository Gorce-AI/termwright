{
  "name": "@termwright/vt",
  "version": "0.1.0",
  "description": "termwright VT core: one terminal factory and one terminal profile, shared by driver, trace, screenshot and ui",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unicode": {
      "types": "./dist/unicode-entry.d.ts",
      "import": "./dist/unicode-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/unicode-entry.ts --format esm --dts --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
