{
  "name": "@termwright/probe-charm",
  "version": "0.2.0",
  "description": "zero-config Bubble Tea probe: an ephemeral Go workspace redirects the build to an instrumented copy, for both majors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/probe-charm"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "upstream-patches"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/probe-charm"
  },
  "dependencies": {
    "@termwright/probe-go": "workspace:*",
    "@termwright/protocol": "workspace:*"
  },
  "devDependencies": {
    "@termwright/driver": "workspace:*"
  }
}
