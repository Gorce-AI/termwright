{
  "name": "@termwright/test",
  "version": "0.5.0",
  "description": "Termwright's exact-certified Vitest runner, fixtures, matchers and semantic snapshots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/test"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "node scripts/vendor-vitest.mjs prepare && tsup src/index.ts src/config.ts src/runner.ts src/vitest-engine.ts --format esm --dts --dts-resolve --sourcemap --clean --external vitest && node scripts/vendor-vitest.mjs seal",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/test"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/resource-broker": "workspace:*",
    "@termwright/run-journal-transport": "workspace:*",
    "@termwright/trace": "workspace:*",
    "@termwright/ui": "workspace:*",
    "@termwright/vt": "workspace:*",
    "@vitest/expect": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "@vitest/pretty-format": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "@vitest/spy": "4.1.11",
    "@vitest/utils": "4.1.11",
    "es-module-lexer": "2.3.2",
    "expect-type": "1.4.0",
    "magic-string": "0.30.21",
    "obug": "2.1.4",
    "pathe": "2.0.3",
    "picomatch": "4.0.5",
    "std-env": "4.2.0",
    "tinybench": "2.9.0",
    "tinyexec": "1.3.0",
    "tinyglobby": "0.2.17",
    "tinyrainbow": "3.1.1",
    "vite": "7.3.6",
    "why-is-node-running": "2.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@termwright/test-provider-internal": "workspace:*",
    "vitest": "4.1.11"
  }
}
