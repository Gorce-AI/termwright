{
  "name": "@termwright/test",
  "version": "0.1.0",
  "description": "Vitest preset: fixtures, matchers, semantic YAML snapshots, trace reporter",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
