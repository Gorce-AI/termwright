{
  "name": "@termwright/resource-broker",
  "version": "0.2.0",
  "description": "Node-only authoritative resource scheduling and worker transport for Termwright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/resource-broker"
  },
  "type": "module",
  "engines": { "node": "^22.0.0 || ^24.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./transport": { "types": "./dist/transport.d.ts", "import": "./dist/transport.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/transport.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/resource-broker"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "devDependencies": {
    "@termwright/local-transport": "workspace:*"
  }
}
