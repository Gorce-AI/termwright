{
  "name": "@termwright/resource-broker",
  "version": "0.4.0",
  "description": "Node-only authoritative resource scheduling and worker transport for Termwright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/resource-broker"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/transport.ts src/vitest.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/resource-broker"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "4.1.11"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@termwright/local-transport": "workspace:*",
    "vitest": "4.1.11"
  }
}
