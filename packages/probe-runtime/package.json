{
  "name": "@termwright/probe-runtime",
  "version": "0.3.0",
  "description": "shared fail-closed transport for zero-config JavaScript probes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/probe-runtime"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/probe-runtime"
  },
  "dependencies": {
    "@termwright/evidence-provider": "workspace:*",
    "@termwright/protocol": "workspace:*"
  }
}
