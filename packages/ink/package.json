{
  "name": "@termwright/ink",
  "version": "0.3.0",
  "description": "Ink annotations and component testing through mountInk or a real PTY fixture",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/ink"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runner"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/ink"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/probe-ink": "workspace:*",
    "@termwright/protocol": "workspace:*"
  },
  "peerDependencies": {
    "ink": "7.1.1",
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@termwright/resource-broker": "workspace:*",
    "@termwright/test": "workspace:*",
    "@types/react": "^19.2.18",
    "ink": "7.1.1",
    "react": "^19.2.8"
  }
}
