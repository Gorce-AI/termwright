{
  "name": "@termwright/ink",
  "version": "0.2.0",
  "description": "Optional annotation-only SDK for the zero-config Ink probe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/ink"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "peerDependencies": {
    "ink": ">=7.1.0",
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
