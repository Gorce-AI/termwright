{
  "kind": "termwright-performance-baseline-policy",
  "schemaVersion": 3,
  "environment": "darwin-arm64-node24-go1.25-bun1.2.15",
  "metrics": {
    "firstRunPreAttemptMs": {
      "unit": "milliseconds",
      "direction": "lower",
      "relativeTolerance": 0.5,
      "absoluteTolerance": 250
    },
    "postStartupRunOrchestrationMs": {
      "unit": "milliseconds",
      "direction": "lower",
      "relativeTolerance": 0.35,
      "absoluteTolerance": 100
    },
    "peakMemoryFootprintBytes": {
      "unit": "bytes",
      "direction": "lower",
      "relativeTolerance": 0.35,
      "absoluteTolerance": 67108864
    },
    "peakOpenFileDescriptors": {
      "unit": "count",
      "direction": "lower",
      "relativeTolerance": 0.25,
      "absoluteTolerance": 16
    },
    "leakedFileDescriptors": {
      "unit": "count",
      "direction": "exact",
      "relativeTolerance": 0,
      "absoluteTolerance": 0
    },
    "leakedProcesses": {
      "unit": "count",
      "direction": "exact",
      "relativeTolerance": 0,
      "absoluteTolerance": 0
    },
    "semanticHotPathP95Us": {
      "unit": "microseconds/frame",
      "direction": "lower",
      "relativeTolerance": 0.5,
      "absoluteTolerance": 50
    },
    "charmOverheadRatio": {
      "unit": "ratio",
      "direction": "lower",
      "relativeTolerance": 0.35,
      "absoluteTolerance": 0.1
    },
    "opentuiOverheadRatio": {
      "unit": "ratio",
      "direction": "lower",
      "relativeTolerance": 0.25,
      "absoluteTolerance": 0.1
    }
  }
}
