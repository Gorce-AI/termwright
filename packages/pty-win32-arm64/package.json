{
  "name": "@termwright/pty-win32-arm64",
  "version": "0.3.0",
  "description": "Prebuilt termwright ConPTY addon for Windows arm64",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/pty-win32-arm64"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    "./termwright_pty.node": "./termwright_pty.node"
  },
  "files": [
    "termwright_pty.node",
    "vendor/conpty.dll",
    "vendor/arm64/OpenConsole.exe",
    "vendor/conpty-manifest.json",
    "vendor/LICENSE.microsoft-terminal.txt",
    "vendor/NOTICE.microsoft-terminal.md",
    "vendor/THIRD_PARTY_NOTICES.md",
    "vendor/SBOM.spdx.json"
  ],
  "termwrightBuild": {
    "optionalArtifacts": [
      "termwright_pty.node"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/check-prebuild.mjs win32 arm64 --allow-missing",
    "typecheck": "node --version"
  }
}
