{
  "name": "@termwright/probe-opentui",
  "version": "0.3.0",
  "description": "zero-config OpenTUI probe: module interception plus Probe IR observation, with no import in the application",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/probe-opentui"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-hook": {
      "types": "./dist/node-hook.d.ts",
      "import": "./dist/node-hook.js"
    },
    "./bun-preload": {
      "types": "./dist/bun-preload.d.ts",
      "import": "./dist/bun-preload.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node-hook.ts src/bun-preload.ts src/output-instrumentation.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/probe-opentui"
  },
  "dependencies": {
    "@termwright/probe-runtime": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/pty": "workspace:*",
    "@termwright/recognizers": "workspace:^",
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.3",
    "@termwright/opentui": "workspace:*"
  }
}
