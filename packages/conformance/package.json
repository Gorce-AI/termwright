{
  "name": "@termwright/conformance",
  "version": "0.1.0",
  "description": "generic/semantic/adversarial fixtures + adapter contract tests",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/fixtures"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:hostile": "vitest run --config vitest.hostile.config.ts src/suites/adversarial.test.ts",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@termwright/ink": "workspace:*",
    "@types/react": "^19.2.18",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
