{
  "name": "@termwright/conformance",
  "version": "0.3.2",
  "description": "generic/semantic/adversarial fixtures + adapter contract tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/conformance"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/fixtures"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/conformance",
    "test:hostile": "pnpm --dir ../.. test -- -- --run packages/conformance/src/suites/adversarial.test.ts packages/conformance/src/suites/mcp-sessions.test.ts",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/resource-broker": "workspace:*",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@termwright/ink": "workspace:*",
    "@termwright/logs": "workspace:*",
    "@termwright/mcp": "workspace:*",
    "@termwright/probe-ink": "workspace:*",
    "@termwright/probe-tview": "workspace:*",
    "@termwright/test": "workspace:*",
    "@types/react": "^19.2.18",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "vitest": "4.1.11"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
