{
  "name": "@termwright/probe-tview",
  "version": "0.4.1",
  "description": "composable tview probe: one public Attach call plus add-only Go compiler injection, with no upstream mutation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/probe-tview"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/probe-tview"
  },
  "dependencies": {
    "@termwright/probe-go": "workspace:*",
    "@termwright/protocol": "workspace:*"
  },
  "devDependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/test-provider-internal": "workspace:*"
  }
}
