{
  "name": "@termwright/gherkin",
  "version": "0.4.1",
  "description": "Gherkin feature files as native @termwright/test cases through a Vitest plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/gherkin"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/runtime.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/gherkin && pnpm --dir ../.. test -- -- --config packages/gherkin/test-fixtures/direct/vitest.config.ts --run packages/gherkin/test-fixtures/direct",
    "test:fixture": "pnpm --dir ../.. test -- -- --config packages/gherkin/test-fixtures/direct/vitest.config.ts --run packages/gherkin/test-fixtures/direct"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.1.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@termwright/test": "workspace:*",
    "source-map-js": "1.2.1",
    "tinyglobby": "0.2.17",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  }
}
