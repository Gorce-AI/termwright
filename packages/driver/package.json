{
  "name": "@termwright/driver",
  "version": "0.2.0",
  "description": "termwright driver: PTY + VT sessions, locators, actions, waits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/driver"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/driver"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/headless": "^6.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@termwright/vt": "workspace:*"
  },
  "optionalDependencies": {
    "@termwright/conpty": "workspace:*"
  }
}
