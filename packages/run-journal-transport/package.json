{
  "name": "@termwright/run-journal-transport",
  "version": "0.3.1",
  "description": "Authenticated worker transport for authoritative Termwright run events",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/run-journal-transport"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/run-journal-transport"
  },
  "dependencies": {
    "@termwright/protocol": "workspace:*"
  },
  "devDependencies": {
    "@termwright/local-transport": "workspace:*"
  }
}
