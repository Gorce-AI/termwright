{
  "name": "@termwright/mcp",
  "version": "0.3.0",
  "description": "thin MCP server over the public driver API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "termwright-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts src/docs.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/mcp"
  },
  "dependencies": {
    "@termwright/driver": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0",
    "@termwright/protocol": "workspace:*",
    "@termwright/screenshot": "workspace:*",
    "@termwright/trace": "workspace:*"
  },
  "devDependencies": {
    "@termwright/resource-broker": "workspace:*"
  }
}
