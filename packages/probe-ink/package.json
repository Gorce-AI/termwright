{
  "name": "@termwright/probe-ink",
  "version": "0.4.1",
  "description": "Ink application instrumentation for Termwright end-to-end semantic tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/probe-ink"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-hook": {
      "types": "./dist/node-hook.d.ts",
      "import": "./dist/node-hook.js"
    },
    "./bun-preload": {
      "types": "./dist/bun-preload.d.ts",
      "import": "./dist/bun-preload.js"
    },
    "./instrumentation": {
      "types": "./dist/instrument.d.ts",
      "import": "./dist/instrument.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node-hook.ts src/bun-preload.ts src/instrument.ts src/instrumentation.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/probe-ink"
  },
  "dependencies": {
    "@termwright/evidence-provider": "workspace:*",
    "@termwright/probe-runtime": "workspace:*",
    "@termwright/protocol": "workspace:*",
    "@termwright/pty": "workspace:*",
    "@termwright/recognizers": "workspace:^",
    "@termwright/vt": "workspace:*"
  },
  "peerDependencies": {
    "ink": "7.1.1",
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@termwright/driver": "workspace:*",
    "@termwright/test-provider-internal": "workspace:*",
    "@types/react": "^19.2.18",
    "ink": "7.1.1",
    "react": "^19.2.8"
  }
}
