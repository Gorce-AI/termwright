{
  "name": "@termwright/desktop-host",
  "version": "0.3.1",
  "description": "Secure Electron host for the Termwright runner UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorce-AI/termwright.git",
    "directory": "packages/desktop-host"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --sourcemap --clean && node scripts/copy-brand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test -- -- --run packages/desktop-host"
  },
  "dependencies": {
    "@electron/packager": "20.3.0",
    "@electron/fuses": "2.1.3",
    "electron": "43.4.1"
  },
  "devDependencies": {
    "png2icons": "2.0.1",
    "sharp": "^0.34.3",
    "vitest": "4.1.11"
  }
}
