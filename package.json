{
  "name": "termwright-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "check:platform-deviations": "node scripts/check-platform-deviations.mjs",
    "check:determinism": "node scripts/audit-determinism-constructs.mjs",
    "check:generated-docs": "pnpm --filter @termwright/mcp... build && node scripts/generate-mcp-docs.mjs && node scripts/generate-runtime-requirements.mjs",
    "check:node-pty": "node scripts/check-node-pty-certification.mjs",
    "check:semantic-completeness": "node scripts/generate-semantic-completeness.mjs",
    "check:mission-completion": "node scripts/generate-mission-completion.mjs",
    "docs:screenshots": "pnpm --filter @termwright/ui run screenshots:docs",
    "docs:api": "typedoc && typedoc --options typedoc.driver.json && typedoc --options typedoc.ink.json && typedoc --options typedoc.gherkin.json && node scripts/prepare-api-docs.mjs",
    "generate:mcp-docs": "pnpm --filter @termwright/mcp... build && node scripts/generate-mcp-docs.mjs --write",
    "generate:runtime-docs": "node scripts/generate-runtime-requirements.mjs --write",
    "test": "node packages/termwright-cli/dist/bin.js test",
    "pretest:compatibility": "pnpm --filter @termwright/protocol --filter @termwright/recognizers --filter @termwright/evidence-provider --filter @termwright/probe-runtime --filter @termwright/probe-go --filter termwright... build",
    "test:compatibility": "node packages/termwright-cli/dist/bin.js test -- compatibility/registry.test.ts",
    "test:watch": "node packages/termwright-cli/dist/bin.js watch",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "eslint packages/*/src"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.10.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  }
}
