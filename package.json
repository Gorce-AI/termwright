{
  "name": "termwright-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "docs:screenshots": "pnpm --filter @termwright/ui run screenshots:docs",
    "test": "vitest run",
    "pretest:compatibility": "pnpm --filter @termwright/protocol --filter @termwright/recognizers --filter @termwright/probe-runtime build",
    "test:compatibility": "vitest run compatibility/registry.test.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "eslint packages/*/src"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  }
}
