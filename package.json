{
  "name": "termwright-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "eslint packages/*/src"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "vitest": "^3.2.0",
    "eslint": "^9.10.0"
  }
}
