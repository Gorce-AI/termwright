{
  "name": "@termwright-examples/ratatui-list",
  "version": "0.0.0",
  "private": true,
  "description": "A Ratatui list tested through an instrumented Cargo build",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "cargo run --manifest-path app/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "termwright": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
