{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/ink/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "packages/ink/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter"],
  "out": "website/src/content/docs/api/ink",
  "readme": "none",
  "entryFileName": "index.md",
  "cleanOutputDir": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "githubPages": false,
  "gitRevision": "main",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/Gorce-AI/termwright/blob/main/packages/ink/src/{path}#L{line}",
  "router": "member",
  "externalSymbolLinkMappings": {
    "@termwright/driver": {
      "TerminalHarness": "https://gorce-ai.github.io/termwright/api/driver/interfaces/terminalharness/",
      "ResolvedTarget.ref": "https://gorce-ai.github.io/termwright/api/driver/interfaces/resolvedtarget/#ref"
    }
  },
  "frontmatterGlobals": {"editUrl": false}
}
